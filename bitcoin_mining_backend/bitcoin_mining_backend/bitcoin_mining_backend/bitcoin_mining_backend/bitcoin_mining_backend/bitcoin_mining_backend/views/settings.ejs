<%- include('partials/header', { title: 'Settings' }) %>
<%- include('partials/sidebar', { user }) %>

<div class="main-content p-4 text-light">
  <h2 class="mb-4">System Settings</h2>

  <div class="settings-card bg-dark rounded-4 p-4 mb-4 shadow-lg" style="background: linear-gradient(135deg, #0f172a, #1e293b);">
    <div class="row g-3">
      <div class="col-md-6">
        <div class="setting-item p-3 bg-gradient rounded-3" style="background: linear-gradient(135deg, #1e293b, #0f172a);">
          <h5 class="text-white mb-2">Site Name</h5>
          <p class="text-muted mb-0">Bitcoin Mining Admin Panel</p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="setting-item p-3 bg-gradient rounded-3" style="background: linear-gradient(135deg, #1e293b, #0f172a);">
          <h5 class="text-white mb-2">Database Connection</h5>
          <p class="text-success mb-0"><i class="fas fa-check-circle me-2"></i>MongoDB Atlas - Connected</p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="setting-item p-3 bg-gradient rounded-3" style="background: linear-gradient(135deg, #1e293b, #0f172a);">
          <h5 class="text-white mb-2">Session Timeout</h5>
          <p class="text-muted mb-0">24 hours</p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="setting-item p-3 bg-gradient rounded-3" style="background: linear-gradient(135deg, #1e293b, #0f172a);">
          <h5 class="text-white mb-2">Default Password</h5>
          <p class="text-muted mb-0">admin@123</p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="setting-item p-3 bg-gradient rounded-3" style="background: linear-gradient(135deg, #1e293b, #0f172a);">
          <h5 class="text-white mb-2">Server Status</h5>
          <p class="text-success mb-0"><i class="fas fa-server me-2"></i>Running on Port 3001</p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="setting-item p-3 bg-gradient rounded-3" style="background: linear-gradient(135deg, #1e293b, #0f172a);">
          <h5 class="text-white mb-2">Environment</h5>
          <p class="text-warning mb-0"><i class="fas fa-code me-2"></i>Development Mode</p>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
