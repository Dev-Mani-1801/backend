<%- include('partials/header', { title: 'Support Tickets' }) %>
<%- include('partials/sidebar', { user }) %>

<div class="main-content">
    <div id="loading" style="display: none;">Searching...</div>

    <div class="card-container">
        <div class="cards">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2>Support Tickets</h2>
                <input
                    type="text"
                    id="ticketSearch"
                    class="form-control"
                    placeholder="Search tickets..."
                    value="<%= searchQuery || '' %>"
                    style="max-width: 250px;"
                />
            </div>

            <div class="table-responsive data-table" id="ticketsTableContainer">
                <table class="table table-dark table-striped table-hover table-bordered align-middle" id="ticketsTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>User Name</th>
                            <th>Email</th>
                            <th>Message</th>
                        </tr>
                    </thead>
                    <tbody id="ticketsTbody">
                        <% tickets.forEach((ticket, index) => { %>
                            <tr>
                                <td><%= (page - 1) * limit + index + 1 %></td>
                                <td><%= ticket.name %></td>
                                <td><%= ticket.email %></td>
                                <td><%= ticket.message %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="pagination mt-3 d-flex align-items-center">
                <% if (page > 1) { %>
                    <a href="?page=<%= page - 1 %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="btn btn-outline-primary me-2">Prev</a>
                <% } %>

                <span class="me-2">Page <%= page %></span>

                <% if (tickets.length === limit) { %>
                    <a href="?page=<%= page + 1 %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="btn btn-outline-primary ms-2">Next</a>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Live Search Script -->
    <script>
        const searchInput = document.getElementById('ticketSearch');
        const ticketsTbody = document.getElementById('ticketsTbody');

        let searchTimeout;
        searchInput.addEventListener('input', () => {
            clearTimeout(searchTimeout);

            searchTimeout = setTimeout(async () => {
                const query = searchInput.value.trim();

                try {
                    const response = await fetch(`/admin/help?q=${encodeURIComponent(query)}&page=1`, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    const data = await response.json();
                    ticketsTbody.innerHTML = '';

                    if (data.tickets.length === 0) {
                        ticketsTbody.innerHTML = '<tr><td colspan="4">No tickets found</td></tr>';
                        return;
                    }

                    data.tickets.forEach((ticket, index) => {
                        const row = document.createElement('tr');
                        row.innerHTML = `
                            <td>${index + 1}</td>
                            <td>${ticket.name}</td>
                            <td>${ticket.email}</td>
                            <td>${ticket.message}</td>
                        `;
                        ticketsTbody.appendChild(row);
                    });

                } catch (err) {
                    console.error('Search failed:', err);
                }
            }, 300);
        });
    </script>

    <script>
        const loading = document.getElementById('loading');
        loading.style.display = 'block';
        loading.style.display = 'none';
    </script>

<%- include('partials/footer') %>
