
<%- include('partials/header', { title }) %>
<%- include('partials/sidebar', { user }) %>

<div class="main-content">

    <div id="loading" style="display: none;">Searching...</div>

    <div class="card-container">
    <div class="card">
        <div class="card-header">
            <h2>Users List</h2>
            <input
                type="text"
                id="userSearch"
                placeholder="Search users..."
                value="<%= searchQuery %>"
                style="padding: 8px; border-radius: 4px; border: 1px solid #ccc;"
            />
        </div>

        <div class="table-responsive" id="usersTableContainer">
            <table class="user-table" id="usersTable">
                <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Email Verified</th>
                    <th>Status</th>
                    <th>Created At</th>
                </tr>
                </thead>
                <tbody id="usersTbody">
                <% users.forEach((user, index) => { %>
                    <tr>
                    <td><%= index + 1 %></td>
                    <td><%= user.name %></td>
                    <td><%= user.email %></td>
                    <td><%= user.emailVerified ? 'Yes' : 'No' %></td>
                    <td><%= user.isActive ? 'Active' : 'Inactive' %></td>
                    <td><%= user.createdAt.toLocaleDateString() %></td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="pagination">
        <% if (page > 1) { %>
            <a href="?page=<%= page - 1 %>">&laquo; Prev</a>
        <% } %>
        <span>Page <%= page %></span>
        <% if (users.length === limit) { %>
            <a href="?page=<%= page + 1 %>">Next &raquo;</a>
        <% } %>
        </div>
    </div>
    </div>

    <script>
        const searchInput = document.getElementById('userSearch');
        const usersTbody = document.getElementById('usersTbody');

        let searchTimeout;
        searchInput.addEventListener('input', () => {
            clearTimeout(searchTimeout);

            searchTimeout = setTimeout(async () => {
            const query = searchInput.value.trim();

            try {
                const response = await fetch(`/admin/users?q=${encodeURIComponent(query)}&page=1`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                const data = await response.json();
                usersTbody.innerHTML = '';

                if (data.users.length === 0) {
                usersTbody.innerHTML = '<tr><td colspan="6">No users found</td></tr>';
                return;
                }

                data.users.forEach((user, index) => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${index + 1}</td>
                    <td>${user.name}</td>
                    <td>${user.email}</td>
                    <td>${user.emailVerified ? 'Yes' : 'No'}</td>
                    <td>${user.isActive ? 'Active' : 'Inactive'}</td>
                    <td>${new Date(user.createdAt).toLocaleString()}</td>
                `;
                usersTbody.appendChild(row);
                });

            } catch (err) {
                console.error('Search failed:', err);
            }
            }, 300);
        });
    </script>


    <script>
        const loading = document.getElementById('loading');

        loading.style.display = 'block';
        loading.style.display = 'none';
    </script>

<%- include('partials/footer') %>
