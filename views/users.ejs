
<%- include('partials/header', { title }) %>
<%- include('partials/sidebar', { user }) %>

<div class="main-content">

    <div id="loading" style="display: none;">Searching...</div>

    <div class="card-container">
        <div class="cards">
            <div class="card-header d-flex justify-content-between align-items-center">
            <h2>Users List</h2>
            <input
                type="text"
                id="userSearch"
                class="form-control"
                placeholder="Search users..."
                value="<%= searchQuery %>"
                style="max-width: 250px;"
            />
            </div>

            <div class="table-responsive data-table" id="usersTableContainer">
            <table class="table table-dark table-striped table-hover table-bordered align-middle" id="usersTable">
                <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Email Verified</th>
                    <th>Status</th>
                    <th>Created At</th>
                </tr>
                </thead>
                <tbody id="usersTbody">
                <% users.forEach((user, index) => { %>
                    <tr>
                    <td><%= (page - 1) * limit + index + 1 %></td>
                    <td><%= user.name %></td>
                    <td><%= user.email %></td>
                    <td><%= user.emailVerified ? 'Yes' : 'No' %></td>
                    <td><%= user.isActive ? 'Active' : 'Inactive' %></td>
                    <td><%= user.createdAt.toLocaleDateString() %></td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
            </div>

            <!-- Pagination -->
            <div class="pagination mt-3 d-flex align-items-center">

                <% if (page > 1) { %>
                    <a href="?page=<%= page - 1 %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="btn btn-outline-primary me-2">Prev</a>
                <% } %>

                <span class="me-2">Page <%= page %></span>

                <% if (users.length === limit) { %>
                    <a href="?page=<%= page + 1 %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="btn btn-outline-primary ms-2">
                    Next
                    </a>
                <% } %>
            </div>
        </div>
    </div>


    <script>
        const searchInput = document.getElementById('userSearch');
        const usersTbody = document.getElementById('usersTbody');

        let searchTimeout;
        searchInput.addEventListener('input', () => {
            clearTimeout(searchTimeout);

            searchTimeout = setTimeout(async () => {
            const query = searchInput.value.trim();

            try {
                const response = await fetch(`/admin/users?q=${encodeURIComponent(query)}&page=1`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                const data = await response.json();
                usersTbody.innerHTML = '';

                if (data.users.length === 0) {
                usersTbody.innerHTML = '<tr><td colspan="6">No users found</td></tr>';
                return;
                }

                data.users.forEach((user, index) => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${index + 1}</td>
                    <td>${user.name}</td>
                    <td>${user.email}</td>
                    <td>${user.emailVerified ? 'Yes' : 'No'}</td>
                    <td>${user.isActive ? 'Active' : 'Inactive'}</td>
                    <td>${new Date(user.createdAt).toLocaleString()}</td>
                `;
                usersTbody.appendChild(row);
                });

            } catch (err) {
                console.error('Search failed:', err);
            }
            }, 300);
        });
    </script>


    <script>
        const loading = document.getElementById('loading');

        loading.style.display = 'block';
        loading.style.display = 'none';
    </script>

<%- include('partials/footer') %>
