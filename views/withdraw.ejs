<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Withdrawal Transactions - DashPro Admin</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .withdraw-container {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 24px;
            margin: 20px 0;
        }

        .withdraw-table {
            overflow-x: auto;
        }

        .withdraw-table table {
            width: 100%;
            border-collapse: collapse;
            background: transparent;
        }

        .withdraw-table th {
            background: rgba(255, 255, 255, 0.05);
            color: #ffffff;
            padding: 16px;
            text-align: left;
            font-weight: 500;
            font-size: 14px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .withdraw-table td {
            padding: 16px;
            color: #ffffff;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            font-size: 14px;
        }

        .withdraw-table tr:hover {
            background: rgba(255, 255, 255, 0.02);
        }

        .transaction-type {
            font-weight: 600;
            margin-bottom: 4px;
        }

        .transaction-desc {
            color: #888;
            font-size: 12px;
        }

        .amount {
            font-weight: 600;
            color: #f44336;
        }

        .no-data {
            text-align: center;
            color: #888;
            font-style: italic;
            padding: 40px;
        }
    </style>
</head>
