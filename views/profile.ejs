<%- include('partials/header', { title: 'Your Profile' }) %>
<%- include('partials/sidebar', { user }) %>

<div class="main-content p-4 text-light">
  <h2 class="mb-4">Your Profile</h2>

  <div class="profile-card bg-dark rounded-4 p-4 mb-4 d-flex align-items-center shadow-lg" style="background: linear-gradient(135deg, #0f172a, #1e293b);">
        <div class="me-4 position-relative">
            <img src="/images/user-placeholder.png" alt="Avatar"
                class="rounded-circle border border-secondary"
                style="width: 100px; height: 100px; object-fit: cover;" />
        </div>

        <div>
            <div class="d-flex align-items-center">
            <h3 class="mb-0 text-white" id="usernameDisplay"><%= user.name?.toUpperCase() || 'USERNAME' %></h3>
            <i class="fas fa-pen ms-3 text-secondary" role="button" id="editUsernameBtn" style="cursor: pointer;" title="Edit username"></i>
            </div>
            <small class="text-muted">Admin</small>

            <!-- Inline username edit form -->
            <form id="editUsernameForm" action="/profile/update-username" method="POST" class="d-none mt-2">
            <div class="input-group input-group-sm">
                <input type="text" name="name" class="form-control bg-dark text-light border-secondary" placeholder="New Username" required>
                <button class="btn btn-primary btn-sm" type="submit">Save</button>
                <button class="btn btn-secondary btn-sm" type="button" id="cancelEditUsername">Cancel</button>
            </div>
            </form>
        </div>
    </div>

  <form action="/profile/update" method="POST" class="bg-gradient rounded-4 p-4 shadow-lg" style="background: linear-gradient(135deg, #1e293b, #0f172a);">
    <div class="row g-3">
      <div class="col-md-6">
        <input type="text" name="firstName" class="form-control form-control-lg bg-dark text-light border-0" placeholder="First Name" value="<%= user.firstName || '' %>">
      </div>
      <div class="col-md-6">
        <input type="text" name="lastName" class="form-control form-control-lg bg-dark text-light border-0" placeholder="Last Name" value="<%= user.lastName || '' %>">
      </div>
      <div class="col-md-6">
        <input type="text" name="organization" class="form-control form-control-lg bg-dark text-light border-0" placeholder="Organization Name" value="<%= user.organization || '' %>">
      </div>
      <div class="col-md-6">
        <input type="text" name="location" class="form-control form-control-lg bg-dark text-light border-0" placeholder="Location" value="<%= user.location || '' %>">
      </div>
      <div class="col-md-6">
        <input type="email" name="email" class="form-control form-control-lg bg-dark text-light border-0" placeholder="E-mail Address" value="<%= user.email || '' %>">
      </div>
      <div class="col-md-6">
        <input type="tel" name="phone" class="form-control form-control-lg bg-dark text-light border-0" placeholder="Phone Number" value="<%= user.phone || '' %>">
      </div>
    </div>

    <div class="mt-4 text-center">
      <button type="submit" class="btn btn-lg px-5 text-white" style="background: linear-gradient(to right, #6366f1, #a855f7); border: none;">
        Save
      </button>
    </div>
  </form>
</div>

<script>
  const editBtn = document.getElementById('editUsernameBtn');
  const editForm = document.getElementById('editUsernameForm');
  const cancelBtn = document.getElementById('cancelEditUsername');
  const usernameDisplay = document.getElementById('usernameDisplay');

  editBtn.addEventListener('click', () => {
    editForm.classList.remove('d-none');
    editBtn.style.display = 'none';
    usernameDisplay.style.display = 'none';
  });

  cancelBtn.addEventListener('click', () => {
    editForm.classList.add('d-none');
    editBtn.style.display = 'inline-block';
    usernameDisplay.style.display = 'block';
  });
</script>

<%- include('partials/footer') %>
